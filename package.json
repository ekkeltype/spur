{
  "name": "spur",
  "private": true,
  "version": "0.1.0",
  "description": "Switch & Spur: a two-player online co-op frontier train game. The Rider fights on the roof, the Engineer drives and dispatches.",
  "homepage": "https://ekkeltype.github.io/spur/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ekkeltype/spur.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "peerjs": "1.5.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
